/out

# Local secrets material — read by bin/load-github-app-secrets.sh,
# never committed
/.local/

# IDE
.metals/
.vscode/
.bsp

# Helm — packed sub-chart tarballs, generated by helm dependency update
umbrella/charts/

# Presentation build artifacts (scoped per-service, not shared)
**/presentation/dist/
**/presentation/node_modules/
**/presentation/package-lock.json
**/presentation/.scala-js-out/

# Docs site — mkdocs build output and uv venv
site/_site/
site/.venv/
