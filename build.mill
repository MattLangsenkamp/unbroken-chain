        object `nimbus-jose-installation-token-minter` extends UbcScalaModule with UbcScoverage {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps ++ Seq(
            mvn"com.nimbusds:nimbus-jose-jwt:9.40"
