//| mvnDeps: ["com.lihaoyi::mill-contrib-docker:$MILL_VERSION", "com.github.lolgab::mill-scalablytyped::0.4.1"]

package build

import mill.*
import mill.scalalib.*
import mill.scalajslib.*
import mill.contrib.docker.DockerModule
import mill.scalajslib.api.ModuleKind
import com.github.lolgab.mill.scalablytyped.*

val scalaVer   = "3.6.4"
val scalaJSVer = "1.20.2"

// Compiler warnings for unused/discarded code. Inherited by every module via
// UbcScalaModule / UbcScalaJSModule. ScalaTests inherits scalacOptions from the
// outer module in Mill 1.x, so test modules pick these up automatically.
val lintOptions = Seq(
  "-Wunused:all",
  "-Wvalue-discard",
  "-Wnonunit-statement"
)

// zio + zio-test must move in lockstep: zio-test's macros reference internal
// zio APIs by name. neotype-tapir 0.4.10 transitively requires zio-test 2.1.24,
// so we pin everything to 2.1.24 to keep classpath resolution coherent.
val zioDeps = Seq(
  mvn"dev.zio::zio:2.1.24"
)

val zioTestDeps = Seq(
  mvn"dev.zio::zio-test:2.1.24",
  mvn"dev.zio::zio-test-sbt:2.1.24"
)

val zioJsonDeps = Seq(
  mvn"dev.zio::zio-json:0.7.3"
)

val tyrianDeps = Seq(
  // Single colon + explicit _sjs1_3 suffix: Mill doesn't auto-add ScalaJS platform suffix
  // to deps defined outside a module, so we use the exact Maven artifact name.
  mvn"io.indigoengine:tyrian-io_sjs1_3:0.14.0"
)

val tapirBaseDeps = Seq(
  mvn"com.softwaremill.sttp.tapir::tapir-core:1.11.9",
  mvn"com.softwaremill.sttp.tapir::tapir-json-zio:1.11.9"
)

val tapirClientDeps = tapirBaseDeps ++ Seq(
  mvn"com.softwaremill.sttp.tapir::tapir-sttp-client:1.11.9",
  mvn"com.softwaremill.sttp.client3::zio:3.9.8"
)

val zioHttpDeps = Seq(
  mvn"dev.zio::zio-http:3.0.1"
)

val tapirServerDeps = tapirBaseDeps ++ zioHttpDeps ++ Seq(
  mvn"com.softwaremill.sttp.tapir::tapir-zio-http-server:1.11.9"
)

val zioOtelDeps = Seq(
  mvn"dev.zio::zio-opentelemetry:3.1.14"
)

val otelSdkDeps = Seq(
  mvn"io.opentelemetry:opentelemetry-sdk:1.45.0",
  mvn"io.opentelemetry:opentelemetry-exporter-otlp:1.45.0",
  mvn"io.opentelemetry.semconv:opentelemetry-semconv:1.29.0-alpha",
  mvn"io.opentelemetry.instrumentation:opentelemetry-logback-appender-1.0:2.11.0-alpha"
)

val loggingDeps = Seq(
  mvn"dev.zio::zio-logging-slf4j2:2.4.0",
  mvn"ch.qos.logback:logback-classic:1.5.6"
)

val magnumDeps = Seq(
  mvn"com.augustnagro::magnum:2.0.0-M3",
  mvn"com.augustnagro::magnumzio:2.0.0-M3"
)

val neotypeDeps = Seq(
  mvn"io.github.kitlangton::neotype:0.4.10"
)

val neotypeZioJsonDeps = Seq(
  mvn"io.github.kitlangton::neotype-zio-json:0.4.10"
)

val neotypeTapirDeps = Seq(
  mvn"io.github.kitlangton::neotype-tapir:0.4.10"
)

val zioConfigDeps = Seq(
  mvn"dev.zio::zio-config-magnolia:4.0.3"
)

val otelSemconvDeps = Seq(
  mvn"io.opentelemetry.semconv:opentelemetry-semconv:1.29.0-alpha"
)


// Base ScalaModule for this project — adds lintOptions on top of Mill defaults.
// Use this everywhere instead of mill.scalalib.ScalaModule. .distinct keeps cross-platform
// modules quiet: a `js` submodule that extends `Shared with UbcScalaJSModule` would
// otherwise pick up lintOptions from both linearized supers and scalac complains.
trait UbcScalaModule extends ScalaModule {
  override def scalacOptions = (super.scalacOptions() ++ lintOptions).distinct
}

// Same as UbcScalaModule but for Scala.js modules.
trait UbcScalaJSModule extends ScalaJSModule {
  override def scalacOptions = (super.scalacOptions() ++ lintOptions).distinct
}

trait ServiceModule extends UbcScalaModule with DockerModule {
  def scalaVersion = scalaVer
  override def mvnDeps = super.mvnDeps() ++ zioDeps

  trait ServiceDockerConfig extends DockerConfig {
    def baseImage = "eclipse-temurin:21-jre"
  }
}

// Convention for modules cross-compiled to both JVM and Scala.js.
// Use for domainPublic and api layers that the frontend needs to consume.
// Sources live in <module>/src/ and are shared by both jvm and js sub-modules.
trait CrossPlatform extends Module {
  trait Shared extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def sources = Task.Sources(moduleDir / os.up / "src")
  }
  object jvm extends Shared
  object js extends Shared with UbcScalaJSModule {
    def scalaJSVersion = scalaJSVer
  }
}

// Mixin for per-service Tyrian SPA modules.
// npm artifacts (package.json, node_modules) are scoped to <service>/presentation/.
// To wrap npm libraries with TypeScript definitions, also mix in WithScalablyTyped.
trait PresentationModule extends UbcScalaJSModule {
  def scalaVersion   = scalaVer
  def scalaJSVersion = scalaJSVer
  override def mvnDeps = tyrianDeps
  // ESModule is required for Tyrian/Cats Effect's @JSExportTopLevel entry point.
  override def moduleKind = ModuleKind.ESModule
}

// Mix this into a PresentationModule to generate Scala.js facades for npm packages
// that have TypeScript definitions. Requires ≥1 typed npm package in package.json.
trait WithScalablyTyped extends ScalablyTyped {
  // Scope npm artifacts to this module's directory rather than the repo root
  override def scalablyTypedBasePath    = Task { moduleDir }
  override def scalablyTypedPackageJson = Task.Source { moduleDir / "package.json" }
}

object `provider-gateways` extends Module {
  object `github-gateway` extends Module {

    object `db-migrations` extends JavaModule {
      override def resources = Task.Sources(moduleDir / "resources")
    }

    object domain extends Module {

      object domainPublic extends Module {
        trait Shared extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def sources = Task.Sources(moduleDir / os.up / "src")
          override def mvnDeps = super.mvnDeps() ++ neotypeDeps
        }
        object jvm extends Shared {
          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }
        object js extends Shared with UbcScalaJSModule {
          def scalaJSVersion = scalaJSVer
          // Explicit _sjs1_3 suffix required — top-level val :: resolves JVM-only at link time
          override def mvnDeps = Seq(mvn"io.github.kitlangton:neotype_sjs1_3:0.4.10")
        }
      }

      object domainPrivate extends UbcScalaModule {
        def scalaVersion = scalaVer
        override def moduleDeps = Seq(domainPublic.jvm)
        // zio-config lives here (rather than in an adapter-extension module) by design:
        // every server module pulls config in anyway, so isolating it from this classpath
        // buys nothing. See `.claude/skills/feature-tdd/layers/domain.md` for the rule.
        override def mvnDeps = super.mvnDeps() ++ neotypeDeps ++ zioDeps ++ zioConfigDeps

        object test extends ScalaTests {
          def testFramework = "zio.test.sbt.ZTestFramework"
          override def mvnDeps = super.mvnDeps() ++ zioTestDeps
        }
      }

      object domainPublicAdapterExtensions extends Module {

        object `zio-json` extends Module {
          trait Shared extends UbcScalaModule {
            def scalaVersion = scalaVer
            override def sources = Task.Sources(moduleDir / os.up / "src")
            override def mvnDeps = zioJsonDeps ++ neotypeZioJsonDeps
          }
          object jvm extends Shared {
            override def moduleDeps = Seq(domainPublic.jvm, common.pagination.jvm, api.`api-defn`.jvm)
          }
          object js extends Shared with UbcScalaJSModule {
            def scalaJSVersion = scalaJSVer
            override def moduleDeps = Seq(domainPublic.js, common.pagination.js, api.`api-defn`.js)
            // Explicit _sjs1_3 suffix required — top-level val :: resolves JVM-only at link time
            override def mvnDeps = Seq(
              mvn"dev.zio:zio-json_sjs1_3:0.7.3",
              mvn"io.github.kitlangton:neotype-zio-json_sjs1_3:0.4.10"
            )
          }
        }

        object magnum extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(domainPublic.jvm)
          override def mvnDeps = magnumDeps
        }
      }

      object domainPrivateAdapterExtensions extends Module {

        object `zio-json` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(domainPrivate, domainPublicAdapterExtensions.`zio-json`.jvm)
          override def mvnDeps = zioJsonDeps
        }

        object magnum extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(domainPrivate)
          override def mvnDeps = magnumDeps
        }
      }
    }

    object core extends Module {

      object ports extends UbcScalaModule {
        def scalaVersion = scalaVer
        override def moduleDeps = Seq(
          domain.domainPublic.jvm,
          domain.domainPrivate,
          common.pagination.jvm
        )
        override def mvnDeps = zioDeps
      }

      object `core-impl` extends UbcScalaModule {
        def scalaVersion = scalaVer
        override def moduleDeps = Seq(
          ports,
          common.`activity-logging`,
          common.`crypto-port`,
          common.`secure-random-port`,
          domain.domainPublicAdapterExtensions.`zio-json`.jvm
        )
        override def mvnDeps = zioDeps ++ zioJsonDeps

        object test extends ScalaTests {
          def testFramework = "zio.test.sbt.ZTestFramework"
          override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          override def moduleDeps = super.moduleDeps ++ Seq(
            adapters.`in-memory-installation-repository`,
            adapters.`in-memory-linked-repo-repository`,
            adapters.`in-memory-pending-link-flow-repository`,
            adapters.`in-memory-webhook-delivery-repository`,
            adapters.`in-memory-github-app-client`,
            adapters.`in-memory-installation-token-minter`,
            common.`deterministic-secure-random`,
            common.`noop-crypto`
          )
        }
      }

      object adapters extends Module {

        // Outbound HTTP adapter implementing GitHubAppClient against GitHub's REST API
        // via Tapir endpoint DSL + sttp's ZIO backend. Tests use SttpBackendStub.
        object `tapir-sttp-github-app-client` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(
            ports,
            domain.domainPublicAdapterExtensions.`zio-json`.jvm
          )
          override def mvnDeps = zioDeps ++ tapirClientDeps ++ neotypeTapirDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // Driven port implementation for InstallationRepository via Magnum + Postgres.
        object `magnum-installation-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(
            ports,
            domain.domainPublicAdapterExtensions.magnum,
            domain.domainPrivateAdapterExtensions.magnum,
            common.`magnum-pagination`
          )
          override def mvnDeps = zioDeps ++ magnumDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps ++ Seq(mvn"org.slf4j:slf4j-simple:2.0.17")
            override def moduleDeps = super.moduleDeps ++ Seq(
              common.`db-test-support`,
              `db-migrations`
            )
          }
        }

        // Driven port implementation for LinkedRepoRepository via Magnum + Postgres.
        object `magnum-linked-repo-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(
            ports,
            domain.domainPublicAdapterExtensions.magnum,
            domain.domainPrivateAdapterExtensions.magnum,
            common.`magnum-pagination`
          )
          override def mvnDeps = zioDeps ++ magnumDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps ++ Seq(mvn"org.slf4j:slf4j-simple:2.0.17")
            override def moduleDeps = super.moduleDeps ++ Seq(
              common.`db-test-support`,
              `db-migrations`
            )
          }
        }

        // Driven port implementation for PendingLinkFlowRepository via Magnum + Postgres.
        object `magnum-pending-link-flow-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(
            ports,
            domain.domainPublicAdapterExtensions.magnum,
            domain.domainPrivateAdapterExtensions.magnum
          )
          override def mvnDeps = zioDeps ++ magnumDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps ++ Seq(mvn"org.slf4j:slf4j-simple:2.0.17")
            override def moduleDeps = super.moduleDeps ++ Seq(
              common.`db-test-support`,
              `db-migrations`
            )
          }
        }

        // Driven port implementation for WebhookDeliveryRepository via Magnum + Postgres.
        object `magnum-webhook-delivery-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(
            ports,
            domain.domainPublicAdapterExtensions.magnum,
            domain.domainPrivateAdapterExtensions.magnum
          )
          override def mvnDeps = zioDeps ++ magnumDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps ++ Seq(mvn"org.slf4j:slf4j-simple:2.0.17")
            override def moduleDeps = super.moduleDeps ++ Seq(
              common.`db-test-support`,
              `db-migrations`
            )
          }
        }

        // In-memory InstallationRepository for local dev and testing — no DB required.
        object `in-memory-installation-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // In-memory LinkedRepoRepository for local dev and testing.
        object `in-memory-linked-repo-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // In-memory PendingLinkFlowRepository for local dev and testing.
        object `in-memory-pending-link-flow-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // In-memory WebhookDeliveryRepository for local dev and testing.
        object `in-memory-webhook-delivery-repository` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // In-memory fake of GitHub's REST API for the App. Used by core service tests
        // that need a deterministic, in-process backend instead of calling github.com.
        object `in-memory-github-app-client` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // In-memory InstallationTokenMinter — returns deterministic dummy JWTs for tests.
        object `in-memory-installation-token-minter` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // Real InstallationTokenMinter: signs RS256 App JWTs from a configured RSA private key
        // using nimbus-jose-jwt. Used by the server bootstrap.
        object `nimbus-jose-installation-token-minter` extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def moduleDeps = Seq(ports)
          override def mvnDeps = zioDeps ++ Seq(
            mvn"com.nimbusds:nimbus-jose-jwt:9.40"
          )

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }
      }
    }

    object api extends Module {

      // Semantic API contract as a Scala trait. Cross-compiled so the Tyrian
      // frontend can share the same types without a second definition.
      // Depends only on domainPublic — never on domainPrivate or any adapter extension.
      object `api-defn` extends Module {
        trait Shared extends UbcScalaModule {
          def scalaVersion = scalaVer
          override def sources = Task.Sources(moduleDir / os.up / "src")
          override def mvnDeps = zioDeps
        }
        object jvm extends Shared {
          override def moduleDeps = Seq(domain.domainPublic.jvm, common.pagination.jvm)
        }
        object js extends Shared with UbcScalaJSModule {
          def scalaJSVersion = scalaJSVer
          override def moduleDeps = Seq(domain.domainPublic.js, common.pagination.js)
          // Explicit _sjs1_3 suffix required — top-level val :: resolves JVM-only at link time
          override def mvnDeps = Seq(mvn"dev.zio:zio_sjs1_3:2.1.17")
        }
      }

      // Inbound HTTP adapter: Tapir endpoints that decode requests and delegate
      // immediately to core. No business logic lives here.
      object `internal-api-adapters` extends Module {
        object http extends UbcScalaModule {
          def scalaVersion = scalaVer
          // Tapir's Schema derivation for nested generics (Page[Installation]) needs
          // a higher inline budget than the default 32.
          override def scalacOptions = super.scalacOptions() ++ Seq("-Xmax-inlines", "64")
          override def moduleDeps = Seq(
            `api-defn`.jvm,
            core.`core-impl`,
            domain.domainPublicAdapterExtensions.`zio-json`.jvm,
            common.`tapir-tracing-interceptor`,
            common.pagination.jvm
          )
          override def mvnDeps = zioDeps ++ tapirServerDeps ++ neotypeTapirDeps ++ zioJsonDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps ++ tapirClientDeps ++ Seq(
              mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub-server:1.11.9"
            )
            override def moduleDeps = super.moduleDeps ++ Seq(
              core.adapters.`in-memory-installation-repository`,
              core.adapters.`in-memory-linked-repo-repository`,
              core.adapters.`in-memory-pending-link-flow-repository`,
              core.adapters.`in-memory-webhook-delivery-repository`,
              core.adapters.`in-memory-github-app-client`,
              core.adapters.`in-memory-installation-token-minter`,
              common.`deterministic-secure-random`,
              common.`noop-crypto`
            )
          }
        }
      }

      // Typed HTTP clients other services import to call this service.
      // Depends only on api-defn and public domain codecs — never on core or private domain.
      object `external-api-adapters` extends Module {
        // JVM client: Tapir endpoint DSL + SttpClientInterpreter. Import this when a
        // JVM service needs to call the GitHub Gateway over HTTP.
        object `tapir-sttp-http` extends UbcScalaModule {
          def scalaVersion = scalaVer
          // Tapir's Schema derivation for nested generics (Page[Installation]) needs
          // a higher inline budget than the default 32.
          override def scalacOptions = super.scalacOptions() ++ Seq("-Xmax-inlines", "64")
          override def moduleDeps = Seq(
            `api-defn`.jvm,
            domain.domainPublicAdapterExtensions.`zio-json`.jvm,
            common.pagination.jvm
          )
          override def mvnDeps = zioDeps ++ tapirClientDeps ++ neotypeTapirDeps

          object test extends ScalaTests {
            def testFramework = "zio.test.sbt.ZTestFramework"
            override def mvnDeps = super.mvnDeps() ++ zioTestDeps
          }
        }

        // Scala.js client: raw sttp + FetchZioBackend (browser Fetch API).
        // No Tapir — FetchZioBackend returns ZIO Task directly, matching the port trait.
        // Explicit _sjs1_3 artifact name required for ScalaJS resolution.
        object `sttp-fetch-js` extends UbcScalaJSModule {
          def scalaVersion = scalaVer
          def scalaJSVersion = scalaJSVer
          override def moduleDeps = Seq(
            `api-defn`.js,
            domain.domainPublicAdapterExtensions.`zio-json`.js,
            common.pagination.js
          )
          override def mvnDeps = Seq(
            mvn"com.softwaremill.sttp.client3:zio_sjs1_3:3.9.8"
          )
        }
      }
    }

    object presentation extends PresentationModule {
      override def moduleDeps = Seq(api.`external-api-adapters`.`sttp-fetch-js`)
      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"io.indigoengine:tyrian-zio_sjs1_3:0.14.0",
        mvn"dev.zio:zio-interop-cats_sjs1_3:23.1.0.3"
      )
    }

    object server extends ServiceModule {
      override def moduleDeps = Seq(
        core.`core-impl`,
        core.adapters.`tapir-sttp-github-app-client`,
        core.adapters.`magnum-installation-repository`,
        core.adapters.`magnum-linked-repo-repository`,
        core.adapters.`magnum-pending-link-flow-repository`,
        core.adapters.`magnum-webhook-delivery-repository`,
        core.adapters.`nimbus-jose-installation-token-minter`,
        common.`aes-gcm-crypto`,
        common.`java-secure-random-generator`,
        api.`internal-api-adapters`.http,
        common.`hikari-magnum-transactor`,
        common.`base-telemetry`,
        common.`server-utils`,
        common.`cors-middleware`
      )
      override def mvnDeps = super.mvnDeps() ++ tapirClientDeps ++ zioConfigDeps
      object docker extends ServiceDockerConfig {
        def tags = List("unbrokenchain/github-gateway:latest")
      }
    }
  }
}

object common extends Module {

  // Postgres connection pool wired to Magnum's TransactorZIO.
  // Reads POSTGRES_HOST / POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD from the
  // environment (set ConfigProvider.envProvider.snakeCase in your server's bootstrap).
  // Exposes a single TaskLayer[TransactorZIO] — wire it in any service that needs DB access.
  object `hikari-magnum-transactor` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = zioDeps ++ zioConfigDeps ++ magnumDeps ++ Seq(
      mvn"com.zaxxer:HikariCP:5.1.0",
      mvn"org.postgresql:postgresql:42.7.2"
    )
  }

  // Structured activity logging: typed case classes with JsonCodec instead of free-form strings.
  // ZIO.logActivity(MyEvent(...)) routes to the correct ZIO log level and serialises to JSON.
  object `activity-logging` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = zioDeps ++ zioJsonDeps
  }

  // OTel SDK wired into ZIO via zio-opentelemetry. Reads OTLP_ENDPOINT from env (falls back to
  // http://otel-collector:4317). Exposes BaseTelemetry.live(serviceName): RLayer[Scope, TelemetryEnv].
  object `base-telemetry` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def moduleDeps = Seq(`activity-logging`)
    override def mvnDeps = zioDeps ++ zioOtelDeps ++ otelSdkDeps ++ loggingDeps ++ zioConfigDeps
  }

  // Shared ZIO HTTP server boilerplate: serverAfterTelemetry, resolvedRoutesLayer, ZServerStarting.
  object `server-utils` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def moduleDeps = Seq(`base-telemetry`, `activity-logging`)
    override def mvnDeps = zioDeps ++ zioHttpDeps ++ zioOtelDeps
  }

  // CORS middleware factory: CorsMiddleware.forHosts(List("localhost")) allows bare host and *.host.
  object `cors-middleware` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = zioHttpDeps
  }

  // Tapir tracing interceptor: TapirTracingInterceptor.serverOptions(tracing) returns
  // ZioHttpServerOptions with a TracingInterceptor — gives every Tapir endpoint an OTel
  // server span with W3C trace-context propagation. Adapted from kinoplan/utils (Apache 2.0).
  object `tapir-tracing-interceptor` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = tapirServerDeps ++ zioOtelDeps ++ otelSemconvDeps
  }

  // Reusable pagination types (Page[A], PageRequest) shared across services.
  // Pure domain types — no JSON/Magnum codecs here. Codec extensions can come later.
  // Cross-compiled (jvm + js) so Scala.js consumers (e.g. typed clients in
  // external-api-adapters/sttp-fetch-js and Tyrian SPAs) can share the same types.
  object pagination extends Module {
    trait Shared extends UbcScalaModule {
      def scalaVersion = scalaVer
      override def sources = Task.Sources(moduleDir / os.up / "src")
      override def mvnDeps = zioDeps
    }
    object jvm extends Shared {
      object test extends ScalaTests {
        def testFramework = "zio.test.sbt.ZTestFramework"
        override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
        override def mvnDeps = super.mvnDeps() ++ zioTestDeps
      }
    }
    object js extends Shared with UbcScalaJSModule {
      def scalaJSVersion = scalaJSVer
      // Explicit _sjs1_3 suffix required — top-level val :: resolves JVM-only at link time
      override def mvnDeps = Seq(mvn"dev.zio:zio_sjs1_3:2.1.17")
    }
  }

  // Shared opaque-cursor pagination helpers for Magnum-backed repositories.
  // Pulls in only Magnum-flavoured cursor encoding (base64-of-offset) — no service-specific code.
  object `magnum-pagination` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = magnumDeps
  }

  // Outbound port for symmetric encryption — operates on plain `String` (UTF-8 plaintext +
  // base64-encoded ciphertext). Each port is its own Mill module so consumers pull in only
  // the trait, not any adapter dep.
  object `crypto-port` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = zioDeps
  }

  // Real Crypto adapter: AES-GCM encryption with a base64-encoded 256-bit key. No `.layer`
  // in the companion — keys come from each consuming service's own config, so the wiring
  // layer lives next to the config rather than here.
  object `aes-gcm-crypto` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def moduleDeps = Seq(`crypto-port`)
    override def mvnDeps = zioDeps

    object test extends ScalaTests {
      def testFramework = "zio.test.sbt.ZTestFramework"
      override def mvnDeps = super.mvnDeps() ++ zioTestDeps
    }
  }

  // No-op Crypto adapter: base64 identity transform. For tests and local dev only.
  object `noop-crypto` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def moduleDeps = Seq(`crypto-port`)
    override def mvnDeps = zioDeps

    object test extends ScalaTests {
      def testFramework = "zio.test.sbt.ZTestFramework"
      override def mvnDeps = super.mvnDeps() ++ zioTestDeps
    }
  }

  // Outbound port for cryptographically secure randomness — `urlSafeRandomString(byteCount)`
  // returns a base64url (no padding) random string. Service-specific newtype wrappers
  // (CodeVerifier, LinkState, …) belong at the call site.
  object `secure-random-port` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = zioDeps
  }

  // Real SecureRandom adapter: java.security.SecureRandom-backed.
  object `java-secure-random-generator` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def moduleDeps = Seq(`secure-random-port`)
    override def mvnDeps = zioDeps

    object test extends ScalaTests {
      def testFramework = "zio.test.sbt.ZTestFramework"
      override def mvnDeps = super.mvnDeps() ++ zioTestDeps
    }
  }

  // Deterministic SecureRandom — counter-backed; emits predictable strings of the requested
  // byte-equivalent length so tests can assert exact values. Not for production.
  object `deterministic-secure-random` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def moduleDeps = Seq(`secure-random-port`)
    override def mvnDeps = zioDeps

    object test extends ScalaTests {
      def testFramework = "zio.test.sbt.ZTestFramework"
      override def mvnDeps = super.mvnDeps() ++ zioTestDeps
    }
  }

  // Reusable ZIO Test database fixture: TestDatabase.suiteLayer / TestDatabase.testLayer.
  // Provides a PostgreSQL 17 Testcontainers container with Flyway migrations and a
  // per-test HikariCP connection that rolls back on teardown.
  //
  // IMPORTANT: Add this module only to test.moduleDeps of consuming modules — never to
  // production moduleDeps. Testcontainers and Flyway must not appear on production classpaths.
  object `db-test-support` extends UbcScalaModule {
    def scalaVersion = scalaVer
    override def mvnDeps = zioDeps ++ magnumDeps ++ Seq(
      mvn"com.zaxxer:HikariCP:5.1.0",
      mvn"org.postgresql:postgresql:42.7.2",
      mvn"org.testcontainers:testcontainers-postgresql:2.0.4",
      mvn"org.flywaydb:flyway-core:10.21.0",
      mvn"org.flywaydb:flyway-database-postgresql:10.21.0"
    )
  }
}

object reader extends Module {
  object server extends ServiceModule {
    object docker extends ServiceDockerConfig {
      def tags = List("unbrokenchain/reader:latest")
    }
  }
}

object writer extends Module {
  object server extends ServiceModule {
    object docker extends ServiceDockerConfig {
      def tags = List("unbrokenchain/writer:latest")
    }
  }
}

object `extraction-service` extends Module {
  object server extends ServiceModule {
    object docker extends ServiceDockerConfig {
      def tags = List("unbrokenchain/extraction-service:latest")
    }
  }
}

object `ubc-control-plane` extends Module {
  object presentation extends PresentationModule
  object server extends ServiceModule {
    object docker extends ServiceDockerConfig {
      def tags = List("unbrokenchain/ubc-control-plane:latest")
    }
  }
}
